# Cognova Voice — Environment Configuration Example
# Copy this file to .env and configure your variables

# Application
APP_NAME="Cognova Voice"
APP_ENV=development
PORT=8000
DEBUG=True
SECRET_KEY=cognova_vortex2k26_super_secret_jwt_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./cognova.db

# Vector Store Path
CHROMA_PERSIST_DIR=./data/vector_store
UPLOADS_DIR=./uploads

# AI LLM Provider Configuration (Supports Gemini, Groq, OpenAI, Ollama/Local)
LLM_PROVIDER=gemini
# Primary free-tier API options:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional Alternative LLM Providers:
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-70b-versatile
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434

# Embedding Model (HuggingFace free local sentence-transformers or Gemini Embeddings)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Voice System Configuration
# STT: browser_native (Web Speech API) | whisper_local | groq_whisper
STT_PROVIDER=browser_native
# TTS: browser_native (Web Speech Synthesis) | edge_tts | gtts
TTS_PROVIDER=browser_native

# Demo Mode Settings
DEMO_MODE_ENABLED=True
DEFAULT_DEMO_STUDENT=Meghana
DEFAULT_DEMO_CAREER="Data Scientist"
